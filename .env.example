# ==============================================================================
# Autonomous AI Sales Voice Agent - Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# LLM Reasoning Engine Configuration
# Supported providers: "groq", "openai", "gemini"
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Speech-to-Text (STT) Configuration
# Supported providers: "groq" (fastest, free tier available), "openai", "browser"
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

# Text-to-Speech (TTS) Configuration
# Supported providers: "edge" (free, no API key required, neural voices), "openai", "elevenlabs"
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Persistence / Database Configuration
DATABASE_PATH=sales_agent.db

# Integrations Configuration
CALENDAR_MODE=mock
CRM_MODE=mock
CRM_WEBHOOK_URL=
